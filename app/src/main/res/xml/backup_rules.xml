<?xml version="1.0" encoding="utf-8"?>
<!-- API 23–30 (fullBackupContent): secret storage never leaves the device.
     secrets.xml holds Android Keystore-encrypted ciphertext only (the key
     itself is non-exportable), milestone0_spike.xml is the debug-build screen's
     plain-prefs store — both are excluded so no key material can ride an
     auto backup. See data/Secrets.kt and the design spec's "never in
     logs or exported backups" rule. -->
<full-backup-content>
    <exclude domain="sharedpref" path="secrets.xml" />
    <exclude domain="sharedpref" path="milestone0_spike.xml" />
</full-backup-content>
